# ─────────────────────────────────────────────────────────────────────────────
# Beacon — environment configuration
# Copy this file to `.env.local` for local development, or add these variables
# to your Vercel project (Settings → Environment Variables) for production.
#
# Never commit a filled-in .env file. `.env*` is git-ignored except this
# example file. Use different values for development and production.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the web app. No trailing slash.
# Local:      http://localhost:3000
# Production: https://beacon.your-domain.com (HTTPS is enforced in production;
#             plain HTTP is accepted only for localhost smoke tests).
APP_URL=http://localhost:3000

# Which proxy headers may be trusted when deriving the client IP for rate
# limits and audit hashes:
#   vercel    - trust them only when running on Vercel (VERCEL=1). Best for the
#               hosted deployment; ignored elsewhere.
#   forwarded - trust the last X-Forwarded-For entry and X-Real-IP. Use this
#               only behind a reverse proxy that overwrites or appends the peer
#               address, e.g. nginx:
#                 proxy_set_header X-Real-IP $remote_addr;
#                 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   none      - never trust forwarded headers (direct exposure).
# Never expose the app directly if this is set to "forwarded".
TRUSTED_PROXY=vercel

# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string. Use the *pooled* connection string for the
# app (host contains "-pooler"), and the direct string for migrations if your
# provider requires it. Neon requires TLS (`sslmode=require`).
DATABASE_URL=postgresql://beacon:password@ep-example-pooler.us-east-2.aws.neon.tech/beacon?sslmode=require

# ── Cryptographic secrets ───────────────────────────────────────────────────
# Generate each value independently:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET signs short-lived codes and hashes request metadata.
AUTH_SECRET=replace-with-a-random-32-byte-base64-value
# ENCRYPTION_KEY encrypts TOTP secrets, SMS numbers, push tokens and photo
# bytes at rest using AES-256-GCM. It MUST decode to exactly 32 bytes. Rotating
# this key requires re-encrypting every protected field; see docs/OPERATIONS.md.
# Keep a backup in your password manager.
ENCRYPTION_KEY=replace-with-a-different-random-32-byte-base64-value

# Protects scheduled maintenance endpoints. Vercel sends it as a bearer token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-random-32-byte-hex-value

# ── Sessions and policy ─────────────────────────────────────────────────────
SESSION_TTL_DAYS=30
LOCATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
MAX_DEVICES_PER_USER=10
ALLOW_SIGNUPS=true
# Check new passwords against the Have I Been Pwned k-anonymity range API.
# Only the first five characters of a SHA-1 hash are sent. Set to false to
# disable the outbound request (fail-open either way).
ENABLE_HIBP=true

# ── Email delivery ──────────────────────────────────────────────────────────
# Default provider order for new accounts:
#   relay_first | resend_first | relay_only | resend_only
# Users can override this in Settings → Email delivery. If a provider fails
# (retryable or permanent), Beacon falls back to the next configured provider
# unless a *_only mode is selected. Each provider is tried twice on retryable
# errors. See docs/EMAIL.md for the exact semantics.
EMAIL_PROVIDER_PRIORITY=relay_first

# The From address used by both providers. It must be on a domain verified by
# the provider you use. Keep the display name if you like.
EMAIL_FROM=Beacon <no-reply@beacon.example.com>
EMAIL_REPLY_TO=
# When no provider is configured, log email recipient, subject, and template in
# development. Leave this false in production; the body is never logged.
EMAIL_DEV_LOG=false
EMAIL_TIMEOUT_MS=10000

# Relay (self-hosted transactional mail; see docs/EMAIL.md)
RELAY_API_BASE_URL=https://relay.example.com
RELAY_API_KEY=
RELAY_FROM=

# Resend (https://resend.com — free tier: 3,000 emails/month)
RESEND_API_KEY=
RESEND_FROM=

# ── Push notifications (optional, reserved) ────────────────────────────────
# The server can sign FCM requests and store an encrypted device token, but the
# Android app in v0.1.0 does not register for push yet. Commands still work:
# the app polls every 15–60 minutes (WorkManager profile) and every 2 minutes
# while lost mode is active.
# These variables are accepted for forward compatibility and future releases.
# Create a service account in Firebase and paste the three values below.
# FCM_PRIVATE_KEY may contain literal "\n" sequences; they are normalized.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Public UI settings ──────────────────────────────────────────────────────
# Free vector styles from OpenFreeMap (no API key, no quota).
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# Link shown by the "Install Android app" action. Point this at a GitHub
# release asset or your own hosted APK.
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_GITHUB_URL=

# In-app Android updates. Installed apps ask their paired server at
# /api/app/update. Point this at a GitHub releases/latest API response and the
# server extracts beacon.apk + beacon.apk.sha256, or set the three explicit
# values below instead. Leave both empty to disable in-app updates.
# The APK must be signed with the same key as the installed app; Android still
# shows a one-tap install confirmation for sideloaded builds.
BEACON_ANDROID_UPDATE_MANIFEST_URL=
# BEACON_ANDROID_VERSION=0.1.3
# BEACON_ANDROID_APK_URL=
# BEACON_ANDROID_APK_SHA256=
# Shown in legal pages. Avoid personal details if you plan to open source.
NEXT_PUBLIC_OPERATOR_NAME=Beacon Project
NEXT_PUBLIC_CONTACT_EMAIL=security@example.com
