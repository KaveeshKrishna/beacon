# Release signing for Beacon.
#
# 1. Copy this file to android/keystore.properties.
# 2. Create a keystore OUTSIDE version control, for example android/beacon-release.jks.
# 3. Replace the placeholders below. Paths are resolved relative to android/app,
#    so `../beacon-release.jks` means android/beacon-release.jks.
#
# android/keystore.properties and *.jks are git-ignored. Never commit either.
# Back up the keystore and passwords in at least two offline locations.

storeFile=../beacon-release.jks
storePassword=replace-with-a-strong-store-password
keyAlias=beacon
keyPassword=replace-with-a-strong-key-password
